{
  "expo": {
    "name": "Wildmark",
    "slug": "wildmark",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wildmark",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Wildmark uses the camera to photograph living organisms.",
        "NSLocationWhenInUseUsageDescription": "Location is optional and used only to improve what is likely around you.",
        "NSPhotoLibraryUsageDescription": "Import a photograph from your library when the camera is not the right tool."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141918",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#141918"
        }
      ],
      "expo-sqlite",
      "expo-image",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Wildmark uses the camera to photograph living organisms."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
